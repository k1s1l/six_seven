# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Максимум сообщений за один запуск (по умолчанию 100)
MAX_MESSAGES=100

# Задержка между отправкой сообщений, в секундах (по умолчанию 0.6)
SEND_DELAY=0.6

# Кулдаун между запусками в одном чате, в секундах (по умолчанию 30)
COOLDOWN_SECONDS=30
